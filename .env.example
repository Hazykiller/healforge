GITHUB_TOKEN=
AI_PROVIDER=gemini  # gemini or openrouter

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=nex-agi/nex-n2.5-mini:free,cohere/north-mini-code:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Alternatively, specify a full ordered chain via OPENROUTER_MODELS:
# OPENROUTER_MODELS=openrouter/free,nex-agi/nex-n2.5-mini:free,cohere/north-mini-code:free
MAX_CONTEXT_CHARS=60000
MAX_PATCH_CHARS=30000
MAX_REPO_CANDIDATES=60
MAX_FILE_CHARS=18000
GITHUB_TIMEOUT_SECONDS=30
GITHUB_CONCURRENCY=8
AI_TIMEOUT_SECONDS=120
SANDBOX_TIMEOUT_SECONDS=600
DOCKER_PULL_IMAGES=false
MAX_SANDBOX_FILE_BYTES=10000000
MAX_SANDBOX_CONTEXT_BYTES=100000000
MAX_REPAIR_ATTEMPTS=2
DOCKER_IMAGE_PYTHON=python:3.12-slim
DOCKER_IMAGE_NODE=node:22-bookworm-slim
ALLOW_WRITE_ACTIONS=false
HOST_WORKSPACE=./workspace

# Verification & Sandbox Provider (auto, docker, remote)
SANDBOX_PROVIDER=auto
# Remote Sandbox Execution Service (for serverless/Vercel zero-Docker deployments)
SANDBOX_URL=
SANDBOX_TOKEN=

